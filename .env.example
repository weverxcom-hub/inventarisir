# ─── NextAuth.js ────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-here-generate-with-openssl-rand-base64-32

# ─── Google Service Account ────────────────────────────────────
# Paste the entire JSON content of your Service Account key file as a single line.
# Example: {"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}
GOOGLE_SERVICE_ACCOUNT_KEY=

# ─── Google Spreadsheet ────────────────────────────────────────
# The ID of your Google Spreadsheet (found in the URL: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit)
# The spreadsheet must have these sheets with headers in row 1:
#   - Users:       Name | Email | Password | Role
#   - Inventory:   Item_ID | Name | Category | Quantity | Location | Condition | Photo_URL | Receipt_URL | QR_URL | Created_At
#   - Procurement: Request_ID | Requestor_Name | Item_Name | Quantity | Estimated_Price | Status | Nota_Photo_Drive_ID | Created_At
GOOGLE_SPREADSHEET_ID=

# ─── Google Drive ──────────────────────────────────────────────
# The ID of the Google Drive folder where receipt/nota photos will be uploaded.
# Share this folder with your Service Account email (client_email in the JSON key).
GOOGLE_DRIVE_FOLDER_ID=
